{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bra-auto-measure.local/schemas/identity-decisions.schema.json",
  "title": "TD-confirmed source identity decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {"const": "identity-decisions.v1"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "source_fingerprint", "style_id", "style_version", "reviewed_by", "reviewed_at"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "style_id": {"type": "string", "minLength": 1},
          "style_version": {"type": "string", "minLength": 1},
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
