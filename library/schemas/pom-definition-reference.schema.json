{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bra-auto-measure.local/schemas/pom-definition-reference.schema.json",
  "title": "Global POM Concept Registry and Contract Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "contracts", "numbering_policy", "concepts"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pom", "anchor"],
      "properties": {
        "pom": {"$ref": "#/$defs/contract"},
        "anchor": {"$ref": "#/$defs/contract"}
      }
    },
    "numbering_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "core_range", "next_assignable_number", "never_reuse_retired_numbers", "joins_use"],
      "properties": {
        "immutable": {"const": true},
        "core_range": {"type": "object", "additionalProperties": false, "required": ["first", "last"], "properties": {"first": {"const": 1}, "last": {"const": 16}}},
        "next_assignable_number": {"type": "integer", "minimum": 18},
        "never_reuse_retired_numbers": {"const": true},
        "joins_use": {"const": "concept_id"}
      }
    },
    "concepts": {"type": "array", "minItems": 17, "items": {"$ref": "#/$defs/concept"}}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["path", "version", "fingerprint"], "properties": {"path": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}},
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "pom_number", "canonical_name_en", "canonical_name_zh", "status", "aliases_approved", "measurement_method", "view", "placement_view_role", "required_anchors", "optional_anchors", "pairing", "unit", "grade_rule_family", "held", "expected_confidence_tier", "applicability_policy", "number_assigned_at", "retired_at"],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "pom_number": {"type": "integer", "minimum": 1},
        "canonical_name_en": {"type": "string", "minLength": 1},
        "canonical_name_zh": {"type": ["string", "null"]},
        "status": {"enum": ["active_contract", "approved", "reserved_pending_definition", "retired"]},
        "aliases_approved": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "measurement_method": {"type": ["string", "null"]},
        "view": {"enum": ["front_outer", "front_inner", "back", "front_to_back", null]},
        "placement_view_role": {"enum": ["front_outer", "front_inner", "back", null]},
        "required_anchors": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "optional_anchors": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "pairing": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["role", "partner_concept_id"], "properties": {"role": {"enum": ["primary", "secondary"]}, "partner_concept_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}}}
          ]
        },
        "unit": {"const": "in"},
        "grade_rule_family": {"type": ["string", "null"]},
        "held": {"type": ["boolean", "null"]},
        "expected_confidence_tier": {"enum": ["high", "medium", "low", null]},
        "applicability_policy": {"type": ["string", "null"]},
        "number_assigned_at": {"type": "string", "format": "date-time"},
        "retired_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "reserved_pending_definition"}}, "required": ["status"]}, "then": {"properties": {"measurement_method": {"type": "null"}, "view": {"type": "null"}, "placement_view_role": {"type": "null"}}}},
        {"if": {"properties": {"status": {"enum": ["active_contract", "approved"]}}, "required": ["status"]}, "then": {"properties": {"measurement_method": {"type": "string", "minLength": 1}, "view": {"enum": ["front_outer", "front_inner", "back", "front_to_back"]}, "required_anchors": {"minItems": 2}}}}
      ]
    }
  }
}
