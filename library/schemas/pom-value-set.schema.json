{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bra-auto-measure.local/schemas/pom-value-set.schema.json",
  "title": "POM Value Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["value_set_id", "record_version", "style_id", "style_version", "status", "unit", "size_system", "source", "memberships", "values", "created_at", "approved_at", "approved_by", "supersedes"],
  "properties": {
    "value_set_id": {"type": "string", "minLength": 1},
    "record_version": {"type": "integer", "minimum": 1},
    "style_id": {"type": "string", "minLength": 1},
    "style_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "approved", "rejected", "superseded"]},
    "unit": {"const": "in"},
    "size_system": {"const": "crossian-alpha-depth-v1"},
    "source": {"$ref": "#/$defs/source"},
    "memberships": {"type": "array", "items": {"$ref": "#/$defs/membership"}},
    "values": {"type": "array", "items": {"$ref": "#/$defs/value"}},
    "created_at": {"type": "string", "format": "date-time"},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "approved_by": {"type": ["string", "null"], "minLength": 1},
    "supersedes": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}, "then": {"properties": {"approved_at": {"type": "string", "format": "date-time"}, "approved_by": {"type": "string", "minLength": 1}}}}
  ],
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["type", "file_name", "file_fingerprint", "sheet", "project_id", "embedded_image_fingerprint"], "properties": {"type": {"enum": ["saved-project-json", "measurement-spec-xlsx", "manual-entry", "td-review"]}, "file_name": {"type": ["string", "null"]}, "file_fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]}, "sheet": {"type": ["string", "null"]}, "project_id": {"type": ["string", "null"]}, "embedded_image_fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]}}},
    "membership": {"type": "object", "additionalProperties": false, "required": ["concept_id", "pom_number", "raw_term", "raw_row_index", "status", "excluded_from_export"], "properties": {"concept_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}, "pom_number": {"type": ["integer", "null"], "minimum": 1}, "raw_term": {"type": ["string", "null"]}, "raw_row_index": {"type": ["integer", "null"], "minimum": 1}, "status": {"enum": ["applicable_present", "applicable_missing", "not_applicable", "unknown_not_provided", "pending_term_mapping"]}, "excluded_from_export": {"type": "boolean"}}},
    "value": {"type": "object", "additionalProperties": false, "required": ["concept_id", "pom_number", "size_code", "value", "source_text", "source_unit", "tolerance_text", "tolerance_value", "origin", "excel_cell", "excel_formula", "grade_rule_version", "override_reason"], "properties": {"concept_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}, "pom_number": {"type": "integer", "minimum": 1}, "size_code": {"enum": ["S", "M", "L", "XL", "2XL", "3XL", "4XL", "5XL", "M2", "L2", "XL2", "2XL2", "3XL2", "4XL2", "5XL2"]}, "value": {"type": "number"}, "source_text": {"type": ["string", "null"]}, "source_unit": {"enum": ["in", "cm", "mm", null]}, "tolerance_text": {"type": ["string", "null"]}, "tolerance_value": {"type": ["number", "null"], "minimum": 0}, "origin": {"enum": ["td-entered", "graded", "derived", "imported-formula", "manual-entry"]}, "excel_cell": {"type": ["string", "null"], "pattern": "^[A-Z]+[1-9][0-9]*$"}, "excel_formula": {"type": ["string", "null"]}, "grade_rule_version": {"type": ["string", "null"]}, "override_reason": {"type": ["string", "null"]}}}
  }
}
