{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bra-auto-measure.local/schemas/landmark-definition.schema.json",
  "title": "Landmark Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["landmark_id", "record_version", "name", "description", "anchor_kind", "allowed_views", "definition_version", "status", "created_at", "retired_at"],
  "properties": {
    "landmark_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
    "record_version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "anchor_kind": {"type": ["string", "null"], "minLength": 1},
    "allowed_views": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["front_outer", "front_inner", "back", "front_to_back"]}},
    "definition_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "retired"]},
    "created_at": {"type": "string", "format": "date-time"},
    "retired_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
